# Copy to .env and fill in. .env is gitignored; never commit real values.

# DEBUG=True enables debug pages and a fixed development SECRET_KEY.
# Production: DEBUG=False and set SECRET_KEY.
DEBUG=True
# SECRET_KEY=
# Comma-separated host names. Default: localhost,127.0.0.1
# ALLOWED_HOSTS=
# Defaults to SQLite (db.sqlite3). For PostgreSQL: postgres://user:pass@host:5432/dbname
# DATABASE_URL=
# Seconds to keep a database connection open (default 60).
# DB_CONN_MAX_AGE=60
# Secure cookies, HSTS and HTTPS redirect. Turn on when served over HTTPS.
# HTTPS_ONLY=False
# LOG_LEVEL=INFO
